# Template only. Fill on the server; never commit the resulting file.
PUBLIC_BASE_URL=https://mail-mcp.example.com
BIND_HOST=127.0.0.1
PORT=8765
DB_PATH=/var/lib/mailru-mcp/state.sqlite3

# Current multi-account mode: generate a Fernet key locally on the server.
