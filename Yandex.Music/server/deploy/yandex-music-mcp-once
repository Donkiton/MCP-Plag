#!/bin/sh
# One request on stdin, EOF, one response; the unit exits with the command.
exec /usr/bin/systemd-run --quiet --pipe --wait --collect --unit="ymmusic-once-$$" \
  --property=User=ymmusic --property=Group=ymmusic \
  --property=WorkingDirectory=/opt/yandex-music-mcp \
  --property=UMask=0077 --property=NoNewPrivileges=true \
  --property=PrivateTmp=true --property=ProtectSystem=strict --property=ProtectHome=true \
  --property=ReadWritePaths=/var/lib/yandex-music-mcp \
  --property=MemoryMax=192M --property=MemoryHigh=128M --property=CPUQuota=30% \
  --property=TasksMax=32 --property=LimitNOFILE=256 --property=KillMode=control-group \
  --setenv=PYTHONNOUSERSITE=1 --setenv=PYTHONDONTWRITEBYTECODE=1 \
  /opt/yandex-music-mcp/venv/bin/python /opt/yandex-music-mcp/oneshot.py
