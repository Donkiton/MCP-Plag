* text=auto
*.py text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.json text eol=lf
*.md text eol=lf
*.png binary
*.ttf binary
*.zip binary
# Preserve archived source bytes and their deployment SHA-256 values.
Mail.ru/plugin/** -text
Mail.ru/server/** -text

# Preserve the exported Yandex Music plugin and server snapshot bytes.
Yandex.Music/plugin/** -text whitespace=cr-at-eol
Yandex.Music/server/** -text whitespace=cr-at-eol
*.whl binary
